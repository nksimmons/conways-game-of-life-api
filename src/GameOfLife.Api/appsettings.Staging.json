{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.AspNetCore.Diagnostics": "Information",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning",
        "GameOfLife": "Debug"
      }
    }
  },
  "Telemetry": {
    "ConsoleExporter": false
  },
  "HttpsRedirection": {
    "Enabled": false
  }
}
