{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Persistence": {
    "Provider": "Sqlite"
  },
  "ConnectionStrings": {
    "GameOfLife": "Data Source=gameoflife.db"
  },
  "GameOfLife": {
    "MaxWidth": 256,
    "MaxHeight": 256,
    "MaxCells": 65536,
    "MaxGenerationsAhead": 1000,
    "FinalStateIterationBudget": 5000,
    "MaxConcurrentEvaluations": 0
  }
}

