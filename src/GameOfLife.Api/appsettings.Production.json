{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning",
        "GameOfLife": "Information"
      }
    }
  },
  "Telemetry": {
    "ConsoleExporter": false
  },
  "HttpsRedirection": {
    "Enabled": false
  },
  "Persistence": {
    "Provider": "Postgres"
  },
  "ConnectionStrings": {
    "GameOfLife": "Host=localhost;Database=gameoflife;Username=gameoflife;Password=gameoflife"
  }
}
