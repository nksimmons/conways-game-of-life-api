{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.AspNetCore": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Information",
        "System": "Information",
        "GameOfLife": "Debug"
      }
    }
  },
  "Telemetry": {
    "ConsoleExporter": true
  },
  "HttpsRedirection": {
    "Enabled": true
  }
}
